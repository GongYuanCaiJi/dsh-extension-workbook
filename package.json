{
  "name": "dsh-extension-workbook",
  "version": "0.1.5",
  "description": "Excel / 工作簿读写 - @firstpick/pi-extension-workbook 的 dsh 移植",
  "type": "module",
  "main": "dist/index.js",
  "types": "./index.ts",
  "license": "MIT",
  "homepage": "https://github.com/GongYuanCaiJi/dsh-extension-workbook#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/GongYuanCaiJi/dsh-extension-workbook.git"
  },
  "bugs": {
    "url": "https://github.com/GongYuanCaiJi/dsh-extension-workbook/issues"
  },
  "keywords": [
    "dsh-plugin",
    "dsh",
    "deepseek-harness",
    "extension",
    "skill",
    "excel",
    "xlsx",
    "xlsm",
    "ooxml"
  ],
  "author": "GongYuanCaiJi",
  "exports": {
    ".": "./dist/index.js",
    "./cordis.patch.yml": "./cordis.patch.yml"
  },
  "files": [
    "dist",
    "src",
    "workers",
    "skills",
    "docs",
    "scripts",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "esbuild index.ts --bundle --platform=node --format=esm --target=node24 --external:@xmldom/xmldom --external:fflate --outfile=dist/index.js",
    "check": "tsc -p tsconfig.json && node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --experimental-strip-types scripts/check.mjs",
    "prepare": "npm run build && npm run check",
    "prepack": "npm run check",
    "test": "npm run build && node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --test test/*.test.mjs",
    "pack:dry": "npm pack --dry-run"
  },
  "dependencies": {
    "@xmldom/xmldom": "^0.9.10",
    "fflate": "^0.8.3",
    "typebox": "^1.3.6"
  },
  "devDependencies": {
    "@types/node": "^24.12.4",
    "esbuild": "^0.25.0",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
